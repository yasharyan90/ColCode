# docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# Where the browser loads the app. Cookies are marked Secure when this is https.
# Client hosted on Vercel? Set this to the Vercel URL (it drives the OAuth callback) and put the
# backend host in SITE_ADDRESS, e.g. APP_URL=https://colcode.vercel.app SITE_ADDRESS=api.example.com
APP_URL=https://editor.example.com
# Caddy site address: a domain → automatic HTTPS via Let's Encrypt; ":80" → plain HTTP.
SITE_ADDRESS=editor.example.com
HTTP_PORT=80
HTTPS_PORT=443

# Secrets — generate with: openssl rand -hex 32
JWT_SECRET=
POSTGRES_PASSWORD=

# GitHub OAuth app; callback URL must be exactly ${APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=Ov23liXxvONYQJcr8RDY
GITHUB_CLIENT_SECRET=644451c89eac76a317ef6304c2febb2947c02152
# Dev login is refused whenever NODE_ENV=production, regardless of this flag. For a staging
# stack without OAuth, set NODE_ENV=staging and AUTH_DEV_LOGIN=1 (anyone can sign in as anyone).
NODE_ENV=production
AUTH_DEV_LOGIN=0

# Tuning
RUN_RATE_MAX=10
RUN_MAX_CONCURRENT=4
SNAPSHOT_DEBOUNCE_MS=2000
