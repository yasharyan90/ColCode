# Copy to client/.env.local for local dev. Vite bakes VITE_* values in at build time.
#
# Sync-server WebSocket URL. Unset → dev: ws://localhost:1234, prod: same origin under /sync.
# When the client is hosted on Vercel the WebSocket must go straight to the backend host
# (Vercel does not proxy WebSocket upgrades), so set this in the Vercel project's env:
#   VITE_SYNC_URL=wss://api.your-domain.com/sync
VITE_SYNC_URL=ws://localhost:1234
